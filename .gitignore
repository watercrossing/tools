# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (uv, venv, virtualenv)
.venv/
venv/
env/

# Test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# --- Node / Playwright ------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Playwright browser-test output
test-results/
playwright-report/
playwright/.cache/
blob-report/

# --- Environment & secrets --------------------------------------------------
.env
.env.*
!.env.example

# sanitise.sh map files: they hold the real secrets. Only sanitise.map.example belongs in git.
sanitise.map
*.sanitise.map

# Saved browser sessions / cookies for live-site probes (e.g. Overleaf). Secrets — never commit.
.auth/
*.storage-state.json

# --- Editors / IDEs ---------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# --- OS cruft ---------------------------------------------------------------
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~
.directory

# --- Claude Code ------------------------------------------------------------
.claude/settings.local.json

# --- Local scratch & captures -----------------------------------------------
# Personal tool inputs/outputs while testing (e.g. Teams chat/transcript
# captures, which may contain private meeting content). Put them here or use a
# `.local.` suffix so they never get committed.
scratch/
_local/
*.local.html
*.local.md

# Rendered Claude Code transcripts (personal session logs, may be private).
claude-render-transcripts/transcripts/
